{
  "name": "fitzone",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio FITZONE gimnasio - validacion con CI/CD en GitHub Actions",
  "scripts": {
    "test": "htmlhint index.html",
    "test:semantic": "html-validate index.html",
    "test:a11y": "node scripts/check-a11y.mjs",
    "test:security": "node scripts/check-security.mjs",
    "build:css": "tailwindcss -i css/tailwind.css -o css/app.css --minify",
    "check": "npm run test && npm run test:semantic && npm run test:a11y && npm run test:security"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.0",
    "htmlhint": "^1.1.4",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3"
  }
}
